NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp_dev
# Conexões por instância (serverless: 3, com o pooler do provedor)
DB_POOL_MAX=20
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
APP_TIMEZONE=America/Sao_Paulo
# Limites da importação em massa
IMPORT_MAX_FILE_MB=15
IMPORT_MAX_ROWS=50000
